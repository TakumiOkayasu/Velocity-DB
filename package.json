{
  "name": "velocity-db",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance RDBMS management tool for Windows",
  "scripts": {
    "lint": "uv run scripts/pdg.py lint",
    "lint:frontend": "cd frontend && bun run lint",
    "lint:fix": "cd frontend && bun run lint:fix",
    "build:frontend": "cd frontend && bun run build",
    "build": "uv run scripts/pdg.py build backend",
    "package": "uv run scripts/pdg.py package"
  },
  "devDependencies": {
    "lefthook": "^2.1.6"
  }
}
